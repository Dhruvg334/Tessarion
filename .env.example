# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key
SUPABASE_SERVICE_ROLE_KEY=

# Generation provider
GOOGLE_GENERATIVE_AI_API_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TESSARION_APP_URL=http://localhost:3000

# Qdrant derived retrieval index
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=tessarion_workspace_chunks_v1
QDRANT_DENSE_VECTOR_SIZE=768

# Neo4j derived graph projection
NEO4J_URI=http://localhost:7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=tessarion-local-change-me
NEO4J_DATABASE=neo4j

# Arize AX / OTLP tracing
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=tessarion
ARIZE_OTLP_ENDPOINT=https://otlp.arize.com/v1/traces
OTEL_SERVICE_NAME=tessarion

# Protected operational endpoints
MCP_SERVER_TOKEN=
INFRASTRUCTURE_HEALTH_TOKEN=
